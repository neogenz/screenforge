{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Le paquet se lit tel quel — `node src/main.ts` pour le développement,
       `build/main.js` pour la configuration d'un agent. Les imports relatifs
       portent l'extension `.ts`, que `tsconfig.build.json` réécrit en `.js`. */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
