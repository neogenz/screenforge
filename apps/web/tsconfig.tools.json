{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    /* Les specs atteignent `src/` (types de calques, droits d'export), donc ce
       projet doit lire le code applicatif dans ses conditions : les `.ts`
       explicites d'`apps/api` et `import.meta.env` de Vite. */
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  /* Les scripts d'outillage restent à la racine : ils pilotent le dépôt entier
     (audits, probes, prerender), pas le seul paquet web. C'est ici qu'ils sont
     typés, parce que ce qu'ils manipulent — `e2e/helpers`, `src/lib` — vit ici. */
  "include": ["e2e/**/*.ts", "playwright.config.ts", "vite.config.ts", "../../scripts/**/*.mjs"]
}
