{
  "name": "bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "//exports": "Les sources, pas un build : `apps/web` importe la forme du protocole en `import type`, donc rien de ce paquet n'atteint le navigateur — mais un RPC renommé casse le client à la compilation.",
  "exports": {
    ".": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    }
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run src"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.2",
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
