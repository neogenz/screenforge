{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Node 22+ exécute ce paquet en dépouillant les types à la volée : il n'y a
       pas d'étape de compilation, donc pas de sortie à écrire, et les imports
       doivent porter l'extension `.ts` que `allowImportingTsExtensions` permet
       d'écrire sans que TypeScript proteste. */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
