{
  "compilerOptions": {
    "target": "ES2023",
    /* `DOM` pour la seule déclaration de `structuredClone` (standard web et
       Node 17+) : le paquet ne touche ni le document ni un canvas. */
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Consommé tel quel — vite pour `apps/web`, types dépouillés à la volée
       pour un démon Node : les imports relatifs portent l'extension `.ts`,
       réécrite en `.js` si jamais on émet vers dist/. */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
