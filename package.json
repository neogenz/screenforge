{
  "name": "screenforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm --filter web run dev",
    "build": "pnpm --filter web run build",
    "build:profiles": "VITE_COMMERCIAL_LAUNCH= pnpm --filter web run build && node scripts/commercial-profile-audit.mjs prelaunch && VITE_COMMERCIAL_LAUNCH=1 pnpm --filter web run build && node scripts/commercial-profile-audit.mjs launch",
    "preview": "pnpm --filter web run preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm run test:unit && pnpm run typecheck && pnpm run lint",
    "test:unit": "pnpm -r run test:unit",
    "test:e2e": "pnpm --filter web run test:e2e",
    "test:release": "pnpm test && pnpm run build:profiles && pnpm run test:e2e && pnpm run audit:contrast && pnpm run audit:scale && pnpm run audit:landing",
    "validate:export": "node scripts/validate-export.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "audit:scale": "node scripts/scale-audit.mjs",
    "audit:landing": "node scripts/landing-audit.mjs",
    "probe:visual": "node scripts/visual-probe.mjs",
    "probe:landing-visuals": "node scripts/landing-visuals.mjs",
    "dev:backend": "pnpm --filter backend run dev",
    "deploy:backend": "pnpm --filter backend run deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,md,json,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jszip": "^3.10.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
